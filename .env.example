# Generate with: openssl rand -hex 32
ADMIN_TOKEN=''
# Public HTTPS origin, no trailing slash. Do not use your Jellyfin origin here.
PUBLIC_BASE_URL=https://relay.example.com
# Only these exact upstream hosts may be used. Redirects are disabled.
UPSTREAM_HOSTS=jellyfin.example.com
# Decimal GB: video cache capped at 9,000,000,000 bytes, including pending writes.
CACHE_MAX_BYTES=9000000000
CHUNK_BYTES=2097152
MAX_CLIENTS=24
# Wait for NAS to generate a requested HLS segment.
HLS_TIMEOUT_SECONDS=90
# Stop our NAS encoder after this many seconds without an upstream segment fetch.
HLS_IDLE_SECONDS=120
# Trust X-Real-IP only from these reverse-proxy peers; use narrower ranges when possible.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# Global settings: managed by /settings in config/.env after migration.
REFRESH_SECONDS=3
FOOTER_ICP=''
FOOTER_NOTICE='本服务仅供授权用户使用，请输入管理密钥。\n如果您没有访问权限，请关闭本页面。'
DEBUG_ENABLED=false
BANDWIDTH_TOTAL_MBPS=200
BANDWIDTH_UTILIZATION=80
BANDWIDTH_CLIENT_MBPS=32
DEFAULT_HEIGHT=1080
DEFAULT_VIDEO_BITRATE=8000000
DEFAULT_AUDIO_BITRATE=192000
DEFAULT_TRANSCODE_VIDEO=true
DEFAULT_VIDEO_CODEC='h264'
DEFAULT_TRANSCODE_AUDIO=true
DEFAULT_PRELOAD_PERCENT=5
NAS_ORIGIN=''
NAS_API_KEY=''
NAS_ACCELERATION='nvenc'
NAS_HARDWARE_ENCODING=true
NAS_VAAPI_DEVICE='/dev/dri/renderD128'
NAS_QSV_DEVICE=''
NAS_DECODING_CODECS='h264,hevc'
NAS_HEVC_10BIT=true
NAS_TONEMAPPING=false
NAS_VPP_TONEMAPPING=false
NAS_LOW_POWER_H264=false
NAS_ENCODING_THREADS=-1

# Live egress budget is independent from VOD; combined limits must fit the NIC.
LIVE_TOTAL_MBPS=100
LIVE_UTILIZATION=80
LIVE_CLIENT_MBPS=16
# Deployment parameters: re-run install.sh after changing these.
# Empty host uses the hostname from PUBLIC_BASE_URL; use a direct DNS record.
LIVE_PUBLIC_HOST=''
LIVE_RTMP_PORT=1935
LIVE_RTSP_PORT=8554
# LIVE_INTERNAL_TOKEN is generated automatically by install.sh; never publish it.
